    <string name="j_forest_night">Floresta ao anoitecer</string>
    <string name="j_forest_night_desc">Pássaros à beira do riacho dão lugar aos grilos, à fogueira e a uma coruja distante.</string>
    <string name="j_beach">Noite na praia</string>
    <string name="j_beach_desc">Ondas grandes e brisa do mar, acalmando até uma beira-mar tranquila.</string>
    <string name="j_night_train">Trem noturno</string>
    <string name="j_night_train_desc">O ritmo constante dos trilhos com chuva na janela.</string>
    <string name="j_rainy_cafe">Café num dia de chuva</string>
    <string name="j_rainy_cafe_desc">Conversas baixinhas e piano suave com chuva lá fora; depois, só a chuva e a lareira.</string>
    <string name="j_temple">Templo na montanha</string>
    <string name="j_temple_desc">Tigelas tibetanas, sinos de vento e um riacho, até um Om grave e contínuo.</string>
    <string name="j_camping">Acampamento no lago</string>
    <string name="j_camping_desc">Fogueira, sapos e grilos, até a chuva começar a bater na barraca.</string>
    <string name="j_flight">Voo noturno</string>
    <string name="j_flight_desc">O zumbido grave e constante de uma cabine em voo longo.</string>
    <string name="j_deep_sleep">Sono profundo</string>
    <string name="j_deep_sleep_desc">Chuva e ruído marrom com ondas delta suaves, ficando mais profundo com o tempo.</string>
    <string name="j_baby">Ninar o bebê</string>
    <string name="j_baby_desc">Sons do útero, um shhh suave e caixinha de música, depois só um ruído calmo.</string>

